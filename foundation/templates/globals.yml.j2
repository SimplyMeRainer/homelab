---
kolla_base_distro: ubuntu
openstack_release: "{{ foundation_openstack_release }}"
# Service images follow the Kolla release series; tags are not digest locks.
network_interface: "{{ foundation_network_interface }}"
api_interface: "{{ foundation_network_interface }}"
tunnel_interface: "{{ foundation_network_interface }}"
# Raw unnumbered physical interface. VLAN tagging happens ONCE in Neutron.
neutron_external_interface: "{{ foundation_external_interface }}"
neutron_bridge_name: br-ex
neutron_plugin_agent: openvswitch
enable_neutron_provider_networks: "yes"
neutron_type_drivers: "flat,vlan,vxlan"
neutron_tenant_network_types: "vxlan"
neutron_physical_networks: "{{ foundation_provider_physnet }}"
kolla_internal_vip_address: "{{ foundation_internal_vip }}"
kolla_external_vip_address: "{{ foundation_external_vip }}"
kolla_internal_fqdn: "api-internal.{{ foundation_domain }}"
kolla_external_fqdn: "api.{{ foundation_domain }}"
node_custom_config: "{{ foundation_runtime }}/kolla/config"
kolla_certificates_dir: "{{ foundation_runtime }}/kolla/certificates"
kolla_enable_tls_internal: "yes"
kolla_enable_tls_external: "yes"
kolla_enable_tls_backend: "yes"
kolla_verify_tls_backend: "yes"
kolla_copy_ca_into_containers: "yes"
openstack_cacert: /etc/ssl/certs/ca-certificates.crt
kolla_admin_openrc_cacert: "{{ foundation_runtime }}/kolla/certificates/ca/root.crt"
enable_cinder: "yes"
enable_cinder_backup: "yes"
glance_backend_ceph: "yes"
cinder_backend_ceph: "yes"
nova_backend_ceph: "yes"
external_ceph_cephx_enabled: true
ceph_glance_user: "glance"
ceph_glance_pool_name: images
ceph_cinder_user: "cinder"
ceph_cinder_pool_name: volumes
ceph_cinder_backup_user: "cinder-backup"
ceph_cinder_backup_pool_name: backups
ceph_nova_user: "cinder"
ceph_nova_pool_name: vms
enable_hacluster: "no"
enable_masakari: "no"
enable_octavia: "yes"
# Required native backend for the default-enabled Octavia jobboard.
enable_valkey: "yes"
octavia_auto_configure: "yes"
octavia_service_auth_project: octavia
octavia_network_type: tenant
octavia_network_interface: o-hm0
octavia_amp_image_tag: amphora
octavia_amp_network_cidr: "{{ foundation_octavia_management_cidr }}"
# SINGLE is a development topology, not HA data-plane availability.
octavia_loadbalancer_topology: SINGLE
octavia_amp_flavor:
  name: amphora
  is_public: false
  vcpus: 1
  ram: 1024
  disk: 5
