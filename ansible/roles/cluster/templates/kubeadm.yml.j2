apiVersion: kubeadm.k8s.io/v1beta4
kind: InitConfiguration
localAPIEndpoint:
  advertiseAddress: {{ node_ip | to_json }}
  bindPort: 6443
nodeRegistration:
  name: {{ inventory_hostname | to_json }}
  criSocket: unix:///run/containerd/containerd.sock
  kubeletExtraArgs:
    - name: node-ip
      value: {{ node_ip | to_json }}
---
apiVersion: kubeadm.k8s.io/v1beta4
kind: ClusterConfiguration
clusterName: {{ cluster_name | to_json }}
kubernetesVersion: v{{ kubernetes_version }}
controlPlaneEndpoint: {{ api_endpoint | to_json }}
networking:
  podSubnet: {{ pod_cidr | to_json }}
  serviceSubnet: {{ service_cidr | to_json }}
apiServer:
  certSANs:
    - {{ api_endpoint.split(':')[0] | to_json }}
    - {{ api_vip | to_json }}
