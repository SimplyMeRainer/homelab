apiVersion: v1
kind: Pod
metadata:
  name: kube-vip
  namespace: kube-system
  annotations:
    lab-kit.example/credentials: {{ vip_credentials_file | default('admin.conf') | to_json }}
spec:
  hostNetwork: true
  containers:
    - name: kube-vip
      image: {{ kube_vip_image | to_json }}
      imagePullPolicy: IfNotPresent
      args: [manager]
      env:
        - {name: vip_arp, value: "true"}
        - {name: port, value: "6443"}
        - {name: vip_interface, value: {{ kube_vip_interface | to_json }} }
        - {name: address, value: {{ api_vip | to_json }} }
        - {name: vip_subnet, value: "32"}
        - {name: cp_enable, value: "true"}
        - {name: cp_namespace, value: kube-system}
        - {name: svc_enable, value: "false"}
        - {name: vip_leaderelection, value: "true"}
        - {name: vip_leaseduration, value: "5"}
        - {name: vip_renewdeadline, value: "3"}
        - {name: vip_retryperiod, value: "1"}
      securityContext:
        capabilities:
          add: [NET_ADMIN, NET_RAW]
      volumeMounts:
        - {name: kubeconfig, mountPath: /etc/kubernetes/admin.conf, readOnly: true}
  volumes:
    - name: kubeconfig
      hostPath:
        path: /etc/kubernetes/kube-vip.conf
        type: File
