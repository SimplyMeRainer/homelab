# Nonsecret only. Replace ALL documentation IPs/hostnames with your lab DNS.
BIND_ADDRESS=192.0.2.40
TLS_DIR=./runtime/pki
SECRET_DIR=./runtime/secrets
IDENTITY_CA_FILE=./runtime/identity/ipa-ca.crt
FORGEJO_HOST=forgejo.lab.example
MINIO_HOST=minio.lab.example
VAULT_HOST=vault.lab.example
KEYCLOAK_HOST=keycloak.lab.example
PROMETHEUS_HOST=prometheus.lab.example
GRAFANA_HOST=grafana.lab.example
ALERTMANAGER_HOST=alertmanager.lab.example
N8N_HOST=n8n.lab.example
LDAP_URL=ldaps://identity.lab.example:636
LDAP_USERS_DN=cn=users,cn=accounts,dc=lab,dc=example
LDAP_BIND_DN=uid=keycloak-bind,cn=sysaccounts,cn=etc,dc=lab,dc=example
LDAP_GROUP_DN=cn=management-users,cn=groups,cn=accounts,dc=lab,dc=example
